# Never commit real secrets.
# Hyperliquid testnet credentials. The private key may be an API/operation key;
# the account address is the unified/main account whose balance/orders are managed.
HL_TESTNET_PRIVATE_KEY=
HL_TESTNET_ACCOUNT_ADDRESS=

# Hyperliquid mainnet credentials. Leave empty until explicitly enabling mainnet workflows.
HL_MAINNET_PRIVATE_KEY=
HL_MAINNET_ACCOUNT_ADDRESS=

# Backward-compatible aliases for older commands/scripts. Prefer the environment-specific names above.
HL_PRIVATE_KEY=
HL_WALLET_ADDRESS=

# Optional: Feishu custom bot webhook for direct trade notifications from the trading process.
# If unset, the bot still trades/logs but does not send direct Feishu notifications.
HLBOT_FEISHU_WEBHOOK=
